# Copiez ce fichier en .env et renseignez les valeurs

# Port du serveur
PORT=3000

# Secret de session (chaîne aléatoire longue)
SESSION_SECRET=changez-moi-par-une-chaine-aleatoire-longue

# Identifiants OAuth Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre-client-secret
# Doit correspondre EXACTEMENT à un URI de redirection autorisé dans la console Google
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
